# Smartlead API Configuration
# Get your API key from: https://app.smartlead.ai/settings/api
SMARTLEAD_API_KEY=your_api_key_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./iman_os.db

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# CORS - comma-separated list of allowed origins
# Set to your frontend URL in production
CORS_ORIGINS=*

# Sync Settings (in minutes)
SYNC_INTERVAL=30
